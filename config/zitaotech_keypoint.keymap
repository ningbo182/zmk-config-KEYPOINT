#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define QWERTY 0
#define ORANGE 1
#define MOUSE 2
#define NAVIG 3
#define SYMBOL 4
#define NUMBER 5
#define FUNCTION 6
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp &kp>;
            quick-tap-ms = <160>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    behaviors {
        lt_lower_enter: layer_tap_lower_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    behaviors {
        lt_c: layer_tap_custom {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        tdLMCLK: tap_dance_L_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp MB3>, <&mkp MB2>;
        };

        arrow_ht: arrow_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&none>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 3>;
            layers = <QWERTY>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            layers = <QWERTY>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <15 16>;
            layers = <QWERTY>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <21 22>;
            layers = <QWERTY>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <5 6>;
            layers = <QWERTY>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <17 20>;
            layers = <QWERTY>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <31 36>;
            layers = <QWERTY>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&mt ESC TAB       &kp Q               &kp W               &kp E           &kp R         &kp T              &kp Y                         &kp U       &kp I               &kp O              &kp P            &kp BSPC
&kp LEFT_CONTROL  &hm LEFT_CONTROL A  &hm LEFT_COMMAND S  &hm LEFT_ALT D  &hm LSHIFT F  &kp G              &mkp LCLK                     &mkp LCLK   &arrow_ht 0 H       &hm RIGHT_SHIFT J  &hm RIGHT_ALT K  &hm RIGHT_GUI L  &hm RIGHT_CONTROL SEMICOLON  &kp ENTER
&kp LSHFT         &kp Z               &kp X               &kp C           &kp V         &kp B              &kp PG_DN                     &kp PG_UP   &msc SCRL_DOWN      &msc SCRL_UP       &kp N            &kp M            &kp COMMA                    &kp DOT    &kp FSLH  &kp RSHFT
&kp LCTRL         &kp LGUI            &kp LALT            &kp C_MUTE      &mt LGUI ESC  &lt_c NAVIG SPACE  &lt_lower_enter ORANGE ENTER  &mo SYMBOL  &lt_c NUMBER SPACE  &mo FUNCTION       &kp C_PLAY       &kp MINUS        &kp EQUAL                    &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LEFT RIGHT>;
        };

        ORANGE_layer {
            display-name = "ORANGE";
            bindings = <
&kp ESC    &kp N1    &kp N2  &kp N3      &kp N4  &kp N5     &kp N6      &kp N7      &kp N8      &kp N9      &kp N0        &kp DEL
&kp CAPS   &trans    &trans  &trans      &trans  &trans     &mkp RCLK   &mkp RCLK   &trans      &trans      &trans        &trans   &kp SQT   &kp ENTER
&kp LSHFT  &trans    &trans  &trans      &trans  &trans     &trans      &trans      &bl BL_DEC  &bl BL_INC  &trans        &trans   &kp LBKT  &kp RBKT   &kp NUBS  &kp RSHFT
&kp LCTRL  &kp LGUI  &BOT    &bt BT_CLR  &trans  &kp SPACE  &mo ORANGE  &mo ORANGE  &kp SPACE   &to MOUSE   &out OUT_TOG  &BOT     &trans    &trans
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&kp TAB           &kp Q     &kp W     &kp E   &kp R   &kp T     &kp Y             &kp U             &kp I     &kp O         &kp P       &kp BSPC
&kp LEFT_CONTROL  &kp A     &kp S     &kp D   &kp F   &kp G     &mkp LCLK         &mkp LCLK         &arrow_ht 0 H     &M_kp MB1 J   &kp K       &kp L      &kp SEMI   &kp ENTER
&kp LSHFT         &kp Z     &kp X     &kp C   &kp V   &kp B     &msc SCRL_DOWN    &msc SCRL_UP      &none     &none         &kp N       &kp M      &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&kp LCTRL         &kp LGUI  &kp LALT  &trans  &trans  &tdLMCLK  &LMouse_sc 0 MB1  &LMouse_sc 0 MB1  &tdRMCLK  &mo FUNCTION  &kp C_MUTE  &kp MINUS  &kp EQUAL  &kp GRAVE
            >;
        };

        NAVIG_layer {
            display-name = "NAVIGATION";
            bindings = <
&kp C_POWER  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)  &kp LG(N6)  &kp LG(N7)  &kp LG(N8)      &kp LG(N9)      &kp LG(N0)    &trans
&trans       &trans      &trans      &trans      &trans      &trans      &trans      &trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT      &kp INSERT   &trans
&trans       &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans          &trans          &kp HOME      &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &kp PRINTSCREEN  &trans
&trans       &trans      &trans      &trans      &trans      &mo NAVIG   &trans      &trans      &trans          &trans          &trans        &trans         &trans       &trans
            >;
        };

        SYMBOL_layer {
            bindings = <
&trans  &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE        &trans          &trans      &trans  &trans  &trans  &trans
&trans  &kp COLON       &kp DOLLAR     &kp PERCENT   &kp CARET             &kp PLUS               &trans          &trans      &trans  &trans  &trans  &trans       &trans  &trans
&trans  &kp TILDE       &kp EXCL       &kp AT_SIGN   &kp HASH              &kp PIPE               &trans          &trans      &trans  &trans  &trans  &trans       &trans  &trans  &kp QUESTION  &trans
&trans  &trans          &trans         &trans        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE  &mo SYMBOL  &trans  &trans  &trans  &bootloader  &trans  &trans
            >;

            label = "SYMBOL";
        };

        NUMBER_layer {
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8  &kp N9   &kp RBKT   &trans  &trans  &trans      &trans  &trans  &trans
&trans  &kp SEMI   &kp N4  &kp N5  &kp N6   &kp EQUAL  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &kp GRAVE  &kp N1  &kp N2  &kp N3   &kp BSLH   &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans  &trans  &kp DOT  &kp N0     &trans  &trans  &mo NUMBER  &trans  &trans  &trans  &trans  &trans
            >;

            label = "NUMBER";
        };

        FUNCTION_layer {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN  &trans  &trans  &trans  &trans        &trans  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK   &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans  &trans  &trans  &trans           &trans  &trans  &trans  &mo FUNCTION  &trans  &trans  &trans  &trans
            >;

            label = "FUNCTION";
        };
    };
};
